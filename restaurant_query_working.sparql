PREFIX ggf: <http://ggf.org/>
PREFIX schema: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT DISTINCT ?name ?url ?description WHERE {
    # Execute search
    BIND(ggf:SEARCH("restaurants Nantes Houssinière campus", 10) AS ?searchGraph)

    # Navigate the schema.org structure
    GRAPH ?searchGraph {
        # Get the feed and its items
        ?feed a schema:DataFeed .
        ?feed schema:dataFeedElement ?feedItem .

        # Get the actual result item
        ?feedItem schema:item ?item .

        # Extract name and URL
        ?item schema:name ?name .

        # The @id is the URL
        BIND(STR(?item) AS ?url)

        # Get description if available
        OPTIONAL { ?item schema:description ?description }
    }

    # Filter to only restaurant-related results
    FILTER(
        CONTAINS(LCASE(?name), "restaurant") ||
        CONTAINS(LCASE(?name), "resto") ||
        CONTAINS(LCASE(?description), "restaurant")
    )
}
ORDER BY ?name
LIMIT 10
