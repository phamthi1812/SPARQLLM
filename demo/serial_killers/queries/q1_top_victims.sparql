PREFIX ggf: <http://ggf.org/>
PREFIX ex: <http://example.org/>

# Query 1: Top 10 Serial Killers by Victim Count
# Category: Basic CSV Aggregation
# Cost: <100ms, zero API calls
# Question: "Show me the top 10 serial killers by number of victims"

SELECT ?name ?proven_victims ?possible_victims ?country
WHERE {
    BIND(ggf:SLM-CSV("./demo/serial_killers/data/serial_killers_clean.csv") AS ?csvGraph)

    GRAPH ?csvGraph {
        ?row ex:name ?name .
        ?row ex:proven_victims ?proven_victims .
        ?row ex:possible_victims ?possible_victims .
        ?row ex:country ?country .
    }
}
ORDER BY DESC(?proven_victims)
LIMIT 10
