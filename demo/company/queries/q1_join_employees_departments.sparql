PREFIX ggf: <http://ggf.org/>
PREFIX ex: <http://example.org/>

# Q1: Join employees with their department information
# This demonstrates basic JOIN between two CSV files

SELECT ?employee_name ?position ?salary ?department_name ?dept_location ?dept_budget
WHERE {
    # Load employees CSV
    BIND(ggf:SLM-CSV("./demo/company/data/employees.csv") AS ?empGraph)

    # Load departments CSV
    BIND(ggf:SLM-CSV("./demo/company/data/departments.csv") AS ?deptGraph)

    # Get employee data
    GRAPH ?empGraph {
        ?emp ex:name ?employee_name .
        ?emp ex:position ?position .
        ?emp ex:salary ?salary .
        ?emp ex:department_id ?dept_id .
    }

    # Join with department data on department_id
    GRAPH ?deptGraph {
        ?dept ex:department_id ?dept_id .
        ?dept ex:department_name ?department_name .
        ?dept ex:location ?dept_location .
        ?dept ex:budget ?dept_budget .
    }
}
ORDER BY ?department_name ?salary DESC
LIMIT 20
