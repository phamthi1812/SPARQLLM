{
  "test_id": "test_14",
  "name": "Graph merge operation",
  "description": "Merge results from multiple GGF calls into single graph",
  "question": "Combine data from two CSV files",
  "logical_plan": {
    "version": "1.0",
    "steps": [
      {
        "id": "step1",
        "operation": "read_filesystem",
        "ggf": {
          "name": "SLM-CSV",
          "args": {
            "file": "./tests/integration/fixtures/data/cities.csv"
          }
        },
        "bindings": {
          "city": "?city",
          "population": "?population"
        }
      },
      {
        "id": "step2",
        "operation": "read_filesystem",
        "ggf": {
          "name": "SLM-CSV",
          "args": {
            "file": "./tests/integration/fixtures/data/countries.csv"
          }
        },
        "bindings": {
          "country": "?country",
          "capital": "?capital"
        }
      },
      {
        "id": "step3",
        "operation": "graph_operation",
        "ggf": {
          "name": "SLM-MERGE",
          "args": {
            "graphs": ["step1Graph", "step2Graph"]
          }
        },
        "depends_on": ["step1", "step2"],
        "bindings": {}
      }
    ],
    "output": {
      "variables": ["city", "population", "country", "capital"]
    }
  },
  "expected_bindings": ["city", "country"],
  "min_results": 1
}
