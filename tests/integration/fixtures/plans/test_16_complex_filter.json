{
  "test_id": "test_16",
  "name": "Complex filtering with multiple conditions",
  "description": "Apply multiple filter conditions (AND/OR logic)",
  "question": "Find cities with population > 500000 AND name starting with 'S'",
  "logical_plan": {
    "version": "1.0",
    "steps": [
      {
        "id": "step1",
        "operation": "read_filesystem",
        "ggf": {
          "name": "SLM-CSV",
          "args": {
            "file": "./tests/integration/fixtures/data/cities.csv"
          }
        },
        "bindings": {
          "city": "?city",
          "population": "?population"
        },
        "filters": ["(?population > 500000) && regex(?city, '^S', 'i')"]
      }
    ],
    "output": {
      "variables": ["city", "population"],
      "order_by": [
        {
          "variable": "population",
          "order": "DESC"
        }
      ]
    }
  },
  "expected_bindings": ["city", "population"],
  "min_results": 0
}
