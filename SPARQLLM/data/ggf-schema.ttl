@prefix ggf: <http://ggf.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .

# Core Class Definition
ggf:GraphGeneratingFunction a rdfs:Class ;
    rdfs:label "Graph Generating Function" ;
    rdfs:comment "A function that returns a named RDF graph URI. Used in SPARQL queries via BIND(ggf:FUNCTION(...) AS ?g) GRAPH ?g { ... } patterns." .

# Function Signature
ggf:signature a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:string ;
    rdfs:comment "Function signature showing parameters and return type. Format: name(param1:type, param2:type) -> Graph" .

ggf:modulePath a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:string ;
    rdfs:comment "Python module path where function is implemented (e.g., SPARQLLM.udf.filesystem.readfile)" .

# Cost Metadata
ggf:costLatencyMs a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Estimated P50 latency in milliseconds for typical invocation" .

ggf:costTokens a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:integer ;
    rdfs:comment "Estimated token consumption for LLM-based GGFs (prompt + completion)" .

ggf:rateLimitPerHour a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:integer ;
    rdfs:comment "API rate limit in calls per hour (for GGFs calling external services)" .

# Capability Metadata
ggf:accessesDataSource a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:string ;
    rdfs:comment "Type of data source accessed. Values: filesystem, llm, web, sql, vector, mcp, graph" .

ggf:deterministic a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True if function returns identical output for identical input (enables caching)" .

ggf:cacheable a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True if results can be safely cached between query executions" .

ggf:requiresNetwork a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True if function requires network access (LLM APIs, web scraping, external databases)" .

# Configuration Requirements
ggf:requiresEnvVar a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:string ;
    rdfs:comment "Required environment variable name (e.g., GROQ_API_KEY, OPENAI_API_KEY). Multiple values indicate multiple required variables." .

ggf:requiresConfig a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:string ;
    rdfs:comment "Configuration parameter required in config.ini (e.g., faiss_index_path, whoosh_index_dir)" .

# Documentation
ggf:description a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:string ;
    rdfs:comment "Human-readable description of what the function does" .

ggf:exampleUsage a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:string ;
    rdfs:comment "Example SPARQL snippet showing how to invoke this GGF" .

# MCP Integration
ggf:mcpServer a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:string ;
    rdfs:comment "MCP server name if this GGF wraps an MCP tool" .

ggf:mcpTool a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:string ;
    rdfs:comment "MCP tool name if this GGF wraps an MCP tool" .

# Provenance (for generated catalog)
ggf:generatedAt a rdf:Property ;
    rdfs:domain ggf:GraphGeneratingFunction ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Timestamp when this catalog entry was generated" .

ggf:catalogVersion a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Semantic version of the catalog schema (e.g., 1.0.0)" .
